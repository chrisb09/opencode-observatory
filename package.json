{
  "name": "opencode-observatory",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./packages/plugin/dist/index.js",
  "types": "./packages/plugin/dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./packages/plugin/dist/index.d.ts",
      "default": "./packages/plugin/dist/index.js"
    },
    "./plugin": {
      "types": "./packages/plugin/dist/index.d.ts",
      "default": "./packages/plugin/dist/index.js"
    }
  },
  "bin": {
    "opencode-observatory": "./packages/plugin/dist/cli.js"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w @observatory/contracts && npm run build -w opencode-observatory-plugin && npm run build -w @observatory/server && npm run build -w @observatory/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "bun test tests",
    "test:integration": "bun --env-file=.env scripts/test-integration.ts",
    "test:opencode": "bun scripts/opencode-smoke.ts",
    "test:browser": "bun --env-file=.env scripts/browser-smoke.ts",
    "benchmark:analytics": "node --env-file=.env --import tsx scripts/benchmark-analytics.ts",
    "dev": "node --watch --env-file=.env --import tsx apps/server/src/index.ts",
    "dev:web": "npm run dev -w @observatory/web",
    "setup:admin": "node --env-file=.env --import tsx apps/server/src/admin.ts",
    "setup:env": "bun scripts/init-env.ts",
    "plugin:setup": "bun packages/plugin/src/cli.ts setup",
    "plugin:import": "bun packages/plugin/src/cli.ts import",
    "plugin:pack": "npm pack -w opencode-observatory-plugin"
  },
  "dependencies": {
    "@opencode-ai/plugin": "1.18.34"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/bun": "^1.3.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3"
  }
}
