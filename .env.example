# Generate real secrets with: npm run setup:env
POSTGRES_PASSWORD=replace-with-random-bootstrap-password
APP_DB_PASSWORD=replace-with-random-application-password
ENCRYPTION_KEY=replace-with-64-random-hex-characters
PUBLIC_URL=http://localhost:7692
DATABASE_URL=postgresql://observatory_app:replace-with-random-application-password@127.0.0.1:7693/observatory
PORT=7692

# Optional: Custom host path for PostgreSQL data storage
# Defaults to the Docker named volume "pgdata". Set this if you want to store database files in a specific host directory.
# PGDATA_SOURCE=./data/postgres

# Optional: Automatic administrator provisioning on initial container startup
# When set, the first administrator account is created automatically without running commands in the container.
# If an administrator already exists in the database, these are safely ignored on reboot.
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=your-secure-password-min-12-chars
